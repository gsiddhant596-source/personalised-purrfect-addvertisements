{
  "manifest_version": 3,
  "name": "AdSenseAI",
  "version": "1.0",
  "description": "Contextual AI ads based on web search and page content.",
  
  
  
"permissions": [
  "tabs",
  "activeTab",
  "scripting",
  "storage"
],

  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  
  "action": {
    "default_popup": "popup.html"
  }
}